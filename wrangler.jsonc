// Cloudflare Workers static-assets deploy (used by "npx wrangler deploy" in Workers Builds).
// Having this file stops Wrangler from trying to auto-configure the Vite project.
{
  "name": "talabat-fire-safety",
  "compatibility_date": "2026-11-01",
  // Tiny Worker that only handles /assets/*: a missing JS/CSS file returns 404 instead of index.html.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*"]
  }
}
